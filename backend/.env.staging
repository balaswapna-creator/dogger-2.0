# ========================================
# DOGGER 2.0 - STAGING ENVIRONMENT
# ========================================

# Environment
ENVIRONMENT=staging
DEBUG=False
RENDER=True
USE_POSTGRES=True

# Django
SECRET_KEY=REPLACE_WITH_SECURE_KEY_FROM_generate_secrets.py

# Database (PostgreSQL)
PGDATABASE=dogger_staging
PGUSER=dogger_user
PGPASSWORD=REPLACE_WITH_SECURE_PASSWORD
PGHOST=staging-db-host.com
PGPORT=5432

# Allowed Hosts
ALLOWED_HOSTS=dogger-staging.onrender.com,.onrender.com

# Security (Production-like)
CORS_ALLOWED_ORIGINS=https://dogger-staging.onrender.com
CSRF_TRUSTED_ORIGINS=https://dogger-staging.onrender.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# JWT (Production settings)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=10080
JWT_SIGNING_KEY=REPLACE_WITH_SECURE_JWT_KEY

# Rate Limiting (Moderate)
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png
ALLOWED_DOCUMENT_EXTENSIONS=.pdf

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=staging@dogger.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD

# Logging
LOG_LEVEL=INFO

# Cloudinary (Production storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Backup
BACKUP_ENABLED=True
BACKUP_DIR=/var/backups/dogger
BACKUP_RETENTION_DAYS=30
# ========================================
# DOGGER 2.0 - PRODUCTION ENVIRONMENT
# ========================================
# ⚠️  CRITICAL: Keep this file SECURE
# ⚠️  NEVER commit to version control
# ⚠️  Store in secure vault (AWS Secrets Manager, etc.)

# Environment
ENVIRONMENT=production
DEBUG=False
RENDER=True
USE_POSTGRES=True

# Django
SECRET_KEY=REPLACE_WITH_SECURE_PRODUCTION_KEY_MINIMUM_50_CHARS

# Database (PostgreSQL)
PGDATABASE=dogger_production
PGUSER=dogger_prod_user
PGPASSWORD=REPLACE_WITH_VERY_SECURE_PASSWORD_USE_PASSWORD_MANAGER
PGHOST=production-db-host.com
PGPORT=5432

# Allowed Hosts
ALLOWED_HOSTS=dogger.com,www.dogger.com,dogger-production.onrender.com

# Security (Maximum)
CORS_ALLOWED_ORIGINS=https://dogger.com,https://www.dogger.com
CSRF_TRUSTED_ORIGINS=https://dogger.com,https://www.dogger.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# JWT (Strict)
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=1440
JWT_SIGNING_KEY=JZHFRYLjtrT00l83zWhjvKYWQ1RtmfeZMrKEep_VwEE4oinA4AzGLGgLU65rxIkaNq7ec-IZh0OyAFSL2ThbBg

# Rate Limiting (Strict)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT=3
LOGIN_RATE_WINDOW=600

# File Upload (Conservative)
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png
ALLOWED_DOCUMENT_EXTENSIONS=.pdf

# Email (Production SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=noreply@dogger.com

# Logging (Production)
LOG_LEVEL=WARNING
LOG_DIR=/var/log/dogger
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10

# Cloudinary (Production)
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_PRODUCTION_CLOUD
CLOUDINARY_API_KEY=REPLACE_WITH_PRODUCTION_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_PRODUCTION_SECRET

# Backup (Production)
BACKUP_ENABLED=True
BACKUP_DIR=/var/backups/dogger/production
BACKUP_RETENTION_DAYS=90

# Monitoring
SENTRY_DSN=REPLACE_WITH_SENTRY_DSN_IF_USING_ERROR_TRACKING

# Admin Security
ADMIN_URL=secure-admin-panel-random-path-12345
AXES_FAILURE_LIMIT=3
AXES_COOLOFF_TIME=30
# Django
SECRET_KEY=change-this-to-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=dogger2-backend.onrender.com

# Database
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# DOGGER 2.0 - BACKEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ========================================
# ENVIRONMENT
# ========================================
ENVIRONMENT=development
DEBUG=True

# ========================================
# DJANGO SETTINGS
# ========================================
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# DATABASE
# ========================================
# SQLite (Development)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# PostgreSQL (Production - uncomment and configure)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=dogger_db
# DATABASE_USER=dogger_user
# DATABASE_PASSWORD=your-secure-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ========================================
# SECURITY
# ========================================
# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session & Cookie Security
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=your-jwt-signing-key-here

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# ========================================
# FILE UPLOAD
# ========================================
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png

# ========================================
# EMAIL CONFIGURATION
# ========================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@dogger.com

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ========================================
# FRONTEND URL
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# API KEYS (Third-party services)
# ========================================
# Add your API keys here
# STRIPE_API_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ========================================
# BACKUP SETTINGS
# ========================================
BACKUP_ENABLED=True
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30